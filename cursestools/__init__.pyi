    UP = ...
    DOWN = ...
    LEFT = ...
    RIGHT = ...

class PrintMode(Enum):
    '''Output modes for printing text to a window.'''
    IMMEDIATE = ...
    BY_WORD = ...
    BY_CHAR = ...


