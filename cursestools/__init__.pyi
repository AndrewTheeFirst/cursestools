class _CurseWidget(ABC):
    '''Emulate inheritance from curses.window which has @final decorator.'''
    def __init__(self): ...
    def __getattr__(self, name: str) -> object: ...
    def getmaxyx(self) -> tuple[int, int]: ...
    def getbegyx(self) -> tuple[int, int]: ...
    def refresh(self) -> None: ...
    def noutrefresh(self) -> None: ...
    @overload
    def chgat(self, attr: int) -> None: ...
    @overload
    def chgat(self, num: int, attr: int) -> None: ...
    @overload
    def chgat(self, y: int, x: int, attr: int) -> None: ...
    @overload
    def chgat(self, y: int, x: int, num: int, attr: int) -> None: ...
    @overload
    def addstr(self, str: str, attr: int = ...) -> None: ...
    @overload
    def addstr(self, y: int, x: int, str: str, attr: int = ...) -> None: ...
    @overload
    def addch(self, ch: ChType, attr: int = ...) -> None: ...
    @overload
    def addch(self, y: int, x: int, ch: ChType, attr: int = ...) -> None: ...
    @overload
    def getkey(self) -> str: ...
    @overload
    def getch(self) -> int: ...

class Page(_CurseWidget):
    '''A Pad-Like widget to abstract scrolling content that cannot all fit in the window at once.'''
    def __init__(self, parent: window, *, multiplier = 1, height = 0, width = 0): ...
    def noutrefresh(self) -> None: ...
    def refresh(self) -> None: ...
    def shift(self, dir: Dir, unit: int = 1) -> None: ...
    def get_parent_window(self) -> _CurseWidget | window: ...
    def get_offset(self) -> tuple[int, int]: ...
    def set_offset(self, *, v_shift: int = -1, h_shift: int = -1) -> None: ...
    def reset_offset(self) -> None: ...

class Terminal:
    '''A widget to display, process, and submit keystrokes.'''
    def __init__(self, nline: int, ncols: int, beg_y: int, beg_x: int, prompt: str = "> "): ...
    def add_command(self, command: str, action: Callable[[], None]): ...
    def rm_command(self, command: str) -> None: ...
    def noutrefresh(self) -> None:...
    def refresh(self) -> None: ...
    def getkey(self) -> ChType: ...
    def proc_key(self, key: ChType) -> None: ...
    def get_text(self) -> str: ...
    def peek_text(self) -> str: ...

class TextBox:
    '''A simple text display box that can print formatted text.'''
    def __init__(self, nlines: int, ncols: int, beg_y: int, beg_x: int, *, outline: bool = False): ...
    def resize(self, nlines: int, ncols: int) -> None: ...
    def mvwin(self, y: int, x: int) -> None: ...
    def erase(self) -> None: ...
    def set_printing_configuration(self, *, align: Align | None = None, v_centered: bool | None = None,\
                                   printing_mode: PrintMode | None = None, delay: float | None = None, pause_multiplier: int | None = None) -> None: ...
    def print(self, text: str): ...

class Panel(_CurseWidget):
    '''An extenstion to curses.window object, whose visibility may be toggled.'''
    def __init__(self, nline: int, ncols: int, beg_y: int, beg_x: int, *, outline: bool = False):
        self.visible: bool = ...
    def toggle(self) -> None: ...
    def show(self) -> None: ...
    def hide(self) -> None: ...
    def clear(self) -> None: ...

class Canvas(Panel):
    '''
    Panel-like window whose purpose is to be overlaid by Pad-like windows.\n
    Canvas isn't meant be written to, but will not stop you in the case that you do.
    '''
    def __init__(self, nline: int, ncols: int, beg_y: int, beg_x: int, *, outline: bool = False, overlay: PadType = None): ...
    def set_overlay(self, overlay: PadType) -> None: ...
    def remove_overlay(self) -> None: ...